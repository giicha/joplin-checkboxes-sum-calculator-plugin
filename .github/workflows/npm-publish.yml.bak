# Этот сценарий запускает сборку плагина Joplin, публикует его в реестр NPM 
# и автоматически прикрепляет скомпилированный файл .jpl к релизу на GitHub.

name: Node.js Package

on:
  release:
    types: [created]

jobs:
  build-and-publish:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '24' # Исправлено на актуальную Node 24 для устранения предупреждений
          registry-url: 'https://registry.npmjs.org/'

      - name: Install dependencies
        run: npm ci

      - name: Build Joplin Plugin
        run: npm run dist

      - name: Publish to NPM
        run: npm publish --access public
        env:
          NODE_AUTH_TOKEN: ${{ secrets.npm_token }} # Использует ваш токен NPM

      - name: Upload JPL to GitHub Release
        uses: softprops/action-gh-release@v1
        with:
          files: publish/*.jpl # Теперь файл точно будет найден, так как сборка прошла в этой же сессии
        env:
          GITHUB_TOKEN: ${{ secrets.TOKEN }}
